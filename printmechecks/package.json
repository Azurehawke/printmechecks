{
  "name": "printmechecks",
  "version": "1.3.6",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.2.0",
    "@tsconfig/node18": "^2.0.1",
    "@types/node": "^18.16.17",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/tsconfig": "^0.4.0",
    "bootstrap": "^5.0.2",
    "bootstrap-icons": "^1.13.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^8.39.0",
    "eslint-plugin-vue": "^9.11.0",
    "npm-run-all": "^4.1.5",
    "pinia": "^2.1.3",
    "prettier": "^2.8.8",
    "print-js": "^1.6.0",
    "printjs": "^1.1.0",
    "to-words": "^4.1.0",
    "typescript": "~5.0.4",
    "vite": "^4.3.9",
    "vue": "^3.3.4",
    "vue-router": "^4.2.2",
    "vue-tsc": "^1.6.5"
  },
  "description": "Print checks locally on blank check stock",
  "author": "Print Me Checks contributors",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.printmechecks.app",
    "productName": "Print Me Checks",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PrintMeChecks-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PrintMeChecks-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Azurehawke",
        "repo": "printmechecks",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Azurehawke/printmechecks.git"
  }
}
